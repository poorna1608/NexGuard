# NexGuard Environment Configuration

# Database Connection (SQLite default for local development)
DATABASE_URL="file:./dev.db"

# Authentication Secret (Minimum 32 characters for JWT HS256 signing)
AUTH_SECRET="nexguard-super-secret-jwt-key-minimum-32-chars-long-secure"

# Port (optional, defaults to 3000)
PORT=3000

# Threat Intelligence Providers
# VirusTotal v3 API Key (Get a free API key at https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=""

# Google Safe Browsing Lookup API v4 Key (Get key at https://console.cloud.google.com/apis/credentials)
GOOGLE_SAFE_BROWSING_API_KEY=""

# URLhaus by abuse.ch (Free public API, optional API key for higher rate limits)
URLHAUS_AUTH_KEY=""

# Public Application URL (used for password reset links in local development or production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
